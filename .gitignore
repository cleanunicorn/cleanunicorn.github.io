# Generated files by hugo
/public/
/resources/_gen/
/node_modules/
/assets/jsconfig.json
hugo_stats.json

# Executable may be added to repository
hugo.exe
hugo.darwin
hugo.linux

# Temporary lock file while building
/.hugo_build.lock

# Editor swap/backup files
*.swp
*.swo
*~

# Generated CV HTML (built by `make cv` before Hugo build).
# Commit static/cv.pdf after regenerating it locally with `make cv-pdf`.
/static/cv.html
# Python bytecode and macOS Finder metadata
__pycache__/
.DS_Store

# Keep credentials and temporary API chunks local. Commit final MP3s and metadata.
/.env
/.env.*
!/.env.example
/.cache/article-audio/
/data/article_audio.json.tmp

# Local Hugo development server cache
/.cache/hugo-dev/
