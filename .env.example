# Full OpenAI-compatible speech URL. Set this to your drove server when ready.
AUDIO_API_URL=http://localhost:8000/v1/audio/speech
# Leave blank if the self-hosted server does not require authentication.
AUDIO_API_KEY=
# Replace with a model and voice supported by your server.
AUDIO_MODEL=your-speech-model
AUDIO_VOICE=alloy
AUDIO_SPEED=1.0
# Stay below your server's per-request input limit (measured in characters).
AUDIO_MAX_INPUT_CHARS=3500
AUDIO_TIMEOUT_SECONDS=300
# Optional provider/model parameters, e.g. instructions or language.
# Single-quote JSON so its double quotes are preserved by the dotenv parser.
AUDIO_EXTRA_PARAMS='{}'
